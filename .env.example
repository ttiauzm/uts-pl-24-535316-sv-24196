# Kredensial MySQL (dipakai service db dan backend)
MYSQL_DATABASE=letterbox
MYSQL_USER=letterbox
MYSQL_PASSWORD=ganti_password_ini
MYSQL_ROOT_PASSWORD=ganti_root_password_ini

# Kunci aplikasi Laravel. WAJIB diisi sebelum menjalankan compose.
APP_KEY=

# Log Laravel keluar ke stdout container (bukan file di dalam container).
LOG_CHANNEL=stdout
LOG_LEVEL=info

# Alamat API yang dipanggil browser. "/api" memakai origin frontend,
# lalu Nginx meneruskannya ke service backend di jaringan Docker.
VITE_API_URL=/api

# Origin yang diizinkan mengakses API langsung (mis. saat dev Vite).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Password admin Grafana (dipakai service grafana pada P11).
GRAFANA_ADMIN_PASSWORD=ganti_password_grafana_ini
