{
	admin off
	auto_https off
	frankenphp

	# P11: aktifkan metrik HTTP (caddy_http_requests_total, dst.)
	metrics

	# Beri nama server API agar bisa difilter di PromQL: server="api"
	servers :8000 {
		name api
	}
}

:8000 {
	root * /app/public
	encode zstd gzip

	# Access log ke stderr -> terbaca lewat `docker compose logs backend`.
	# Ini juga menjadi bukti bahwa permintaan API dilayani FrankenPHP.
	log {
		output stderr
		format console
	}

	php_server
}

# P11: endpoint metrik Prometheus. Port 9180 TIDAK dipublikasikan ke host
# (hanya terjangkau di jaringan app-net), jadi tidak terbuka ke publik.
:9180 {
	metrics /metrics
}
