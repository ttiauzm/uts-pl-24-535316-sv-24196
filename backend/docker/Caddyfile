{
    frankenphp
    order frankenphp_server before file_server
    
    # Ini akan mengekspos metrics di localhost:2019 secara default
    servers {
        metrics
    }
}

:8000 {
    root * public
    encode zstd gzip
    
    # Matikan auto-HTTPS agar healthcheck HTTP biasa berhasil
    tls internal

    frankenphp_server
    file_server
}